@baseUrl = http://localhost:5000/api

###
# Login as Admin to get an admin token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@courtease.my",
  "password": "Admin@1234"
}

###
# Login as Player to get a player token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "player1@courtease.my",
  "password": "Player@1234"
}

###
# TEST 1 - Should return 200 - successfully approve a pending booking
PATCH {{baseUrl}}/admin/bookings/6aa11cc8b47aca4bd249c9c8/approve
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhOTg0OGUzNDc5NDllM2Q5MWU1MWJmNCIsImlhdCI6MTc4ODk1MTg1NiwiZXhwIjoxNzkxNTQzODU2fQ.UWknacHRGog_NEKhcYkqTDv8tGPjWRN9AEY3ATblvmw

