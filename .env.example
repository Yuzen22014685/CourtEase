PORT=5000
MONGO_URI=mongodb://localhost:27017/courtease
JWT_SECRET=your_super_secret_jwt_key_change_in_production
# Optional: secret for signed upload links (falls back to JWT_SECRET)
# UPLOAD_URL_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="CourtEase <no-reply@courtease.my>"
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
# TURNSTILE_SECRET_KEY=
# File storage: 'local' (default, files in uploads/) or 'cloudinary' (deployment)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix in Cloudinary (default: courtease)
# CLOUDINARY_FOLDER=courtease

# Email: 'smtp' (Gmail, local) or 'brevo' (HTTPS API; needed on Render free, which blocks SMTP ports)
# Default: brevo when BREVO_API_KEY is set, otherwise smtp
# EMAIL_PROVIDER=
BREVO_API_KEY=
# Sender shown in emails; must be a verified sender in Brevo
EMAIL_FROM="CourtEase" <your_verified_sender@gmail.com>
